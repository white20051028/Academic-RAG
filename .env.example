# 复制为 .env 后填入自己的值。.env 已在 .gitignore 里，不会被提交。

# 硅基流动 API Key —— 用于 embedding（BAAI/bge-m3）和生成（Qwen）
# 免费注册：https://cloud.siliconflow.cn/
SILICONFLOW_API_KEY=

# 可选：如果想让 P2 通过 P1 网关生成（复用降级/限流/计量），填网关的鉴权 key
# 不填则直接用 SILICONFLOW_API_KEY 调模型
GATEWAY_API_KEY=

# 可选：P1 网关地址
# GATEWAY_URL=http://127.0.0.1:6066
